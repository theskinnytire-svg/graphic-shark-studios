{
  "$schema": "node_modules/wrangler/config-schema.json",

  // One Worker serves the whole site: dist/client holds the hashed static
  // assets, dist/server/server.js is the server-rendered entry.
  "name": "graphic-shark-studios",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files serve directly; anything else (including "/") falls through to
  // the SSR Worker. Do NOT set run_worker_first.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },

  "vars": { "HF_ENV": "production", "APP_SLUG": "graphic-shark-studios" },

  // Quote and demo submissions are stored here.
  // 1. run:  bunx wrangler d1 create graphic-shark-leads
  // 2. paste the database_id it prints in place of the placeholder below
  // 3. run:  bun run db:apply
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graphic-shark-leads",
      "database_id": "5cb1fc83-23ee-4c19-815e-bbdb1996dc16"
    }
  ]
}
